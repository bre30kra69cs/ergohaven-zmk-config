#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        tab_morph: tab_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "TAB_MORPH";
            bindings = <&kp A>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        escp_morph: escp_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ESCP_MORPH";
            bindings = <&kp Q>, <&kp ESC>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        alt_morph: alt_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_MORPH";
            bindings = <&kp Z>, <&kp LEFT_ALT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        a_morph: a_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "A_MORPH";
            bindings = <&kp S>, <&kp A>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        ru_en_toggle: ru_en_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "RU_EN_TOGGLE";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "PASTE";
        };

        save: save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "SAVE";
        };

        revert: revert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "REVERT";
        };

        macro_one: one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "ONE";
        };

        macro_zero: zero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "ZERO";
        };

        next_page: next_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "NEXT_PAGE";
        };

        prev_page: prev_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "PREV_PAGE";
        };

        pop_history: pop_history {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp LEFT_BRACKET>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "POP_HISTORY";
        };

        push_history: push_history {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp RIGHT_BRACKET>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "PUSH_HISTORY";
        };

        macro_two: two {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "TWO";
        };

        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp D>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "SELECT_WORD";
        };

        macro_c: macro_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "MACRO_C";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q            &kp W            &kp F              &kp P                &kp G                          &kp J  &kp L                 &kp U               &kp Y             &kp BACKSPACE
  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_SHIFT R  &hml LEFT_CONTROL T  &kp D                          &kp H  &hmr RIGHT_CONTROL N  &hmr RIGHT_SHIFT E  &hmr RIGHT_ALT I  &hmr RIGHT_GUI O
  &kp Z            &kp X            &kp C              &kp V                &kp B                          &kp K  &kp M                 &kp COMMA           &kp DOT           &kp FSLH
                                                       &kp LEFT_COMMAND     &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp LEFT_SHIFT
            >;

            display-name = "Base";
        };

        macros {
            bindings = <
  &kp ESC  &kp HOME  &kp UP    &kp END    &kp PRINTSCREEN                    &kp PAGE_UP    &trans             &kp F11          &kp F12        &trans
  &kp TAB  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DELETE                         &kp PAGE_DOWN  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RIGHT_GUI
  &trans   &trans    &trans    &trans     &kp CAPS                           &trans         &trans             &trans           &trans         &trans
                               &trans     &trans           &trans    &trans  &mo 3          &trans
            >;

            display-name = "Macros";
        };

        symbols {
            bindings = <
  &kp ESC  &kp LT                &kp EQUAL  &kp GT                 &kp GRAVE                            &kp CARET  &kp LBKT        &kp UNDER  &kp RBKT         &trans
  &kp TAB  &kp LEFT_PARENTHESIS  &kp MINUS  &kp RIGHT_PARENTHESIS  &kp PLUS                             &kp PRCNT  &kp LEFT_BRACE  &kp SEMI   &kp RIGHT_BRACE  &kp EXCLAMATION
  &trans   &kp ASTRK             &kp COLON  &kp BACKSLASH          &kp DOUBLE_QUOTES                    &kp SQT    &kp PIPE        &kp TILDE  &kp AMPS         &trans
                                            &trans                 &mo 3              &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        numbers {
            bindings = <
  &hml F1 N1    &hml F2 N2  &hml F3 N3      &hml F4 N4  &hml F5 N5                    &hmr F6 N6        &hmr F7 N7    &hmr F8 N8       &hmr F9 N9    &hmr F10 N0
  &kp LEFT_GUI  &trans      &kp LEFT_SHIFT  &trans      &trans                        &kp C_MUTE        &kp C_VOL_DN  &kp RIGHT_SHIFT  &kp C_VOL_UP  &kp RIGHT_GUI
  &trans        &trans      &trans          &trans      &trans                        &kp C_PLAY_PAUSE  &kp C_PREV    &trans           &kp C_NEXT    &trans
                                            &trans      &trans      &trans    &trans  &trans            &trans
            >;
        };
    };
};
